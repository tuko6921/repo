{
  "uid": "zabbix-tapbox",
  "title": "Zabbix Host Overview",
  "tags": ["zabbix", "tapbox"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
