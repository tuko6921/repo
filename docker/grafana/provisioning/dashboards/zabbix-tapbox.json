    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU utilization - $host",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 7 },
      "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "zabbix" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "stacking": { "mode": "none" }, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "zabbix" },
          "queryType": 0,
          "mode": 0,
          "group": { "filter": "/.*/", "limit": 0 },
          "host": { "filter": "$host", "limit": 0 },
          "application": { "filter": "", "limit": 0 },
          "item": { "filter": "CPU utilization", "limit": 0 },
